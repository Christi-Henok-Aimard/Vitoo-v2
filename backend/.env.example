# Serveur
NODE_ENV=development
PORT=4000
DATABASE_URL=file:./vitoo.db

# Sécurité (OBLIGATOIRE en production : chaîne aléatoire de 48 bytes)
JWT_SECRET=change-me-with-a-long-random-string

# Administration (compte créé au démarrage si aucun admin n'existe)
ADMIN_BOOTSTRAP_PHONE=07XXXXXXXX
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-password

# URLs
CLIENT_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# GeniusPay (paiement en ligne)
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_BASE_URL=https://geniuspay.ci/api/v1/merchant
GENIUSPAY_WEBHOOK_SECRET=

# Notifications optionnelles (laisser vide = notifications dans l'application uniquement)
RESEND_API_KEY=
RESEND_FROM_EMAIL=vitoo@resend.dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_FROM=
